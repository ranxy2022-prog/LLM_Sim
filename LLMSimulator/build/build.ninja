#############################################
# Link the executable run

build run: CXX_EXECUTABLE_LINKER__run_Release eval/CMakeFiles/run.dir/test.cpp.o | libllm_system.so || libllm_system.so
  DEP_FILE = eval/CMakeFiles/run.dir/link.d
  FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -Wl,--dependency-file=eval/CMakeFiles/run.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,/home/xiangyur/projects/projects/DSE/LLM_Sim/LLMSimulator/build  libllm_system.so
  OBJECT_DIR = eval/CMakeFiles/run.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = run
  TARGET_PDB = run.dbg


